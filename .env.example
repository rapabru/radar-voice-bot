# ============================================================
# CONFIGURACIÓN DEL BOT DE DISCORD
# ============================================================

# Token secreto del bot (Obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=TU_TOKEN_DE_DISCORD_AQUI

# Prefijo para comandos de texto tradicionales (también soporta Slash Commands /)
COMMAND_PREFIX=!

# Umbral en segundos para considerar que alguien entró y salió "de inmediato" (Modo Fantasma)
GHOST_THRESHOLD_SECONDS=30

# ============================================================
# CONFIGURACIÓN DE IA (OPCIONAL PERO RECOMENDADO)
# ============================================================

# Clave de Google Gemini para respuestas inteligentes y búsqueda en tiempo real
# Obtenla gratis en: https://aistudio.google.com
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI_AQUI
